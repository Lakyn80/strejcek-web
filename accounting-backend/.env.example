# App
APP_ENV=development
ACCOUNTING_API_PREFIX=/api/accounting
ACCOUNTING_BACKEND_HOST=127.0.0.1
ACCOUNTING_BACKEND_PORT=8000

# Database and storage
ACCOUNTING_DATABASE_URL=sqlite:///./data/accounting.db
ACCOUNTING_STORAGE_PATH=./data/accounting-storage

# Admin auth
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
ADMIN_DISPLAY_NAME=Accounting Admin
ADMIN_EMAIL=
SECRET_KEY=
ADMIN_TOKEN_TTL_SECONDS=28800

# CORS: comma-separated admin frontend origins only
ADMIN_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# Accounting integrations
ACCOUNTING_EMAIL_PROVIDER=console
ACCOUNTING_EMAIL_FROM=
ACCOUNTING_SMTP_HOST=
ACCOUNTING_SMTP_PORT=587
ACCOUNTING_SMTP_USER=
ACCOUNTING_SMTP_PASSWORD=
ACCOUNTING_SMTP_USE_TLS=true
# Resend (set ACCOUNTING_EMAIL_PROVIDER=resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=faktury@pvm-deal.cz
RESEND_FROM_NAME=PVM Deal
ACCOUNTING_INVOICE_COPY_EMAIL=robin.strejcek@centrum.cz
ACCOUNTING_ARES_PROVIDER=mock

# PDF branding fallbacks (BIC should match bank code in Settings; 0800 = ČS)
ACCOUNTING_ISSUER_BIC=GIBACZPX
ACCOUNTING_ISSUER_WEBSITE=https://pvm-deal.cz
ACCOUNTING_ISSUER_PHONE_FALLBACK=+420777863255

# Company identity, IČO/DIČ, bank account, invoice defaults, and owner email
# are configured after login in the accounting admin Settings screen.
