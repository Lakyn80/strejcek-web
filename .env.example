# === Zkopíruj jako .env a vyplň hodnoty ===

# Flask
FLASK_ENV=production
SECRET_KEY=ZMEN_NA_NAHODNY_RETEZEC

# Mail (Centrum.cz)
MAIL_SERVER=smtp.centrum.cz
MAIL_PORT=465
MAIL_USE_TLS=False
MAIL_USE_SSL=True
MAIL_USERNAME=robin.strejcek@centrum.cz
MAIL_PASSWORD=HESLO
MAIL_DEFAULT_SENDER="Palety • Big-Bagy • Krabice PVM-Deal.cz <robin.strejcek@centrum.cz>"
