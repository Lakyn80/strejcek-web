# Docker host bindings selected after local port audit.
FLASK_HOST_BIND=127.0.0.1
FLASK_HOST_PORT=8070
ACCOUNTING_HOST_BIND=127.0.0.1
ACCOUNTING_HOST_PORT=8071
FRONTEND_HOST_BIND=127.0.0.1
FRONTEND_HOST_PORT=8095
ADMIN_HOST_BIND=127.0.0.1
ADMIN_HOST_PORT=8096

# Local checkout/cache of Lakyn80/cz-accounting-module used by Docker builds.
# `npm install` in admin creates this ignored cache automatically.
CZ_ACCOUNTING_MODULE_CONTEXT=./admin/.accounting-ui/cz-accounting-module

# Required for accounting-backend. Generate the hash with:
# cd accounting-backend
# python -m app.auth hash-password "your-admin-password"
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
ADMIN_DISPLAY_NAME=Accounting Admin
ADMIN_EMAIL=
SECRET_KEY=
ADMIN_ALLOWED_ORIGINS=http://127.0.0.1:8096

# Optional accounting integrations.
ACCOUNTING_EMAIL_PROVIDER=console
ACCOUNTING_EMAIL_FROM=accounting@example.invalid
ACCOUNTING_ARES_PROVIDER=mock
